@page
@model ContactManager.Pages.Contacts.DeleteModel

@{
	ViewData["Title"] = "Excluir contato";
}

<h1>Excluir contato</h1>

<div class="alert alert-danger" role="alert">
	Tem certeza de que deseja excluir o contato <strong>@Model.Contact.Name</strong>?
</div>

<form method="post" asp-route-id="@Model.Contact.Id">
	<div class="mt-3">
		<button type="submit" class="btn btn-danger">Excluir</button>
		<a asp-page="./Index" class="btn btn-secondary ms-2">Cancelar</a>
	</div>
</form>
