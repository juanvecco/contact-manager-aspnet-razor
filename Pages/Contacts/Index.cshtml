@page
@model ContactManager.Pages.Contacts.IndexModel

@{
	ViewData["Title"] = "Contatos";
}

<h1>Contatos</h1>

@if (User.Identity?.IsAuthenticated == true)
{
	<p>
		<a asp-page="./Create" class="btn btn-primary">Novo contato</a>
	</p>
}

<form method="get" class="row g-3 align-items-end mb-4">
	<div class="col-12 col-lg-5">
		<label asp-for="SearchTerm" class="form-label">Buscar contato</label>
		<input asp-for="SearchTerm" class="form-control"
			   placeholder="Nome, e-mail ou contato" />
	</div>
	<div class="col-6 col-lg-3">
		<label asp-for="OrderBy" class="form-label">Ordenar por</label>
		<select asp-for="OrderBy" class="form-select">
			<option value="name">Nome</option>
			<option value="email">E-mail</option>
			<option value="contactnumber">Contato</option>
		</select>
	</div>
	<div class="col-6 col-lg-2">
		<label asp-for="Direction" class="form-label">Ordem</label>
		<select asp-for="Direction" class="form-select">
			<option value="asc">Crescente</option>
			<option value="desc">Decrescente</option>
		</select>
	</div>
	<div class="col-12 col-lg-2 d-flex gap-2">
		<button type="submit" class="btn btn-primary flex-fill">Filtrar</button>
		<a asp-page="./Index" class="btn btn-secondary flex-fill">Limpar</a>
	</div>
</form>

@if (Model.Contacts.Count == 0)
{
	<p>Nenhum contato cadastrado.</p>
}
else
{
	<div class="table-responsive">
	<table class="table align-middle">
			<thead>
				<tr>
					<th>Nome</th>
					<th>E-mail</th>
					<th>Contato</th>
					@if (User.Identity?.IsAuthenticated == true)
					{
						<th>Ações</th>
					}
				</tr>
			</thead>
			<tbody>
				@foreach (var contact in Model.Contacts)
				{
					<tr>
						<td>@contact.Name</td>
						<td>@contact.Email</td>
						<td>@contact.ContactNumber</td>
						@if (User.Identity?.IsAuthenticated == true)
						{
							<td>
								<a asp-page="./Edit" asp-route-id="@contact.Id" class="btn btn-primary">Editar</a>
								<a asp-page="./Details" asp-route-id="@contact.Id" class="btn btn-secondary">Ver detalhes</a>
								<a asp-page="./Delete" asp-route-id="@contact.Id" class="btn btn-danger">Excluir</a>
							</td>
						}
					</tr>
				}
			</tbody>
	</table>
	</div>
}
